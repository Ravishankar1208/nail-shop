PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/nailshop
JWT_SECRET=replace-with-your-secret-key
# Use the local frontend URL for development; set CLIENT_URL to
# https://nail-shop-phi.vercel.app on Render.
CLIENT_URL=http://localhost:5173

# Required only when running npm run seed:admin.
ADMIN_EMAIL=admin@nailatelier.com
ADMIN_NAME=Nail Atelier Admin
ADMIN_PASSWORD=change-me-before-seeding
